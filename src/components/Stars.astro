---
/**
 * Stars —— 评分星级展示
 */
import Icon from './Icon.astro';

interface Props {
  rating: number;
  count?: number;
  size?: number;
  showValue?: boolean;
  class?: string;
}

const { rating, count, size = 14, showValue = false, class: className = '' } = Astro.props;

// 生成 5 个星星的状态：full / half / empty
const stars = Array.from({ length: 5 }, (_, i) => {
  const filled = rating - i;
  if (filled >= 0.75) return 'full';
  if (filled >= 0.25) return 'half';
  return 'empty';
});
---

<div class:list={['flex items-center gap-1.5', className]}>
  <div class="flex items-center gap-0.5" role="img" aria-label={`评分 ${rating.toFixed(1)} 分（满分 5 分）`}>
    {
      stars.map((state) => (
        <Icon
          name={state === 'empty' ? 'star' : state === 'half' ? 'star-half' : 'star'}
          size={size}
          class={state === 'empty' ? 'text-ink-300' : 'text-gold-500'}
        />
      ))
    }
  </div>
  {
    showValue && (
      <span class="text-sm font-semibold text-strong tabular-nums">{rating.toFixed(1)}</span>
    )
  }
  {
    count !== undefined && count > 0 && (
      <span class="text-xs text-faint tabular-nums">
        ({count > 999 ? `${(count / 1000).toFixed(1)}k` : count})
      </span>
    )
  }
</div>

---
/**
 * Header —— 全站吸顶导航
 * 含桌面端下拉菜单、移动端抽屉、以及右上角常驻的转化按钮。
 */
import Icon from './Icon.astro';
import AffiliateButton from './AffiliateButton.astro';
import { PRIMARY_NAV, SITE, AFFILIATE } from '../consts';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href.split('#')[0]);
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-[var(--hairline)] bg-white/85 backdrop-blur-lg transition-shadow duration-300"
>
  {/* 顶部转化条 —— 常年展示的最大优惠 */}
  <div class="bg-brand-700 text-white">
    <div class="container-page flex items-center justify-center gap-x-3 gap-y-1 py-2 text-center text-[0.8125rem]">
      <Icon name="percent" size={14} class="shrink-0" />
      <span class="font-medium">
        本月亮优惠：48 个月付立省 75%，叠加优惠码
        <code class="mx-1 rounded bg-white/20 px-1.5 py-0.5 font-mono text-[0.75rem] font-bold tracking-wide">{AFFILIATE.couponCode}</code>
        再省 {AFFILIATE.couponPercent}%
      </span>
      <a
        href="/deals"
        class="hidden shrink-0 items-center gap-1 font-semibold underline decoration-white/40 underline-offset-2 hover:decoration-white sm:inline-flex"
      >
        查看详情
        <Icon name="chevron-right" size={13} />
      </a>
    </div>
  </div>

  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-6">
      {/* Logo */}
      <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
        <span
          class="flex h-9 w-9 items-center justify-center rounded-[0.625rem] bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-[0_4px_14px_-3px_rgb(103_61_230/0.5)] transition-transform duration-300 group-hover:scale-105"
        >
          <Icon name="rocket" size={19} strokeWidth={1.9} />
        </span>
        <span class="flex flex-col leading-none">
          <span class="text-[1.0625rem] font-extrabold tracking-tight text-strong">
            Hostinger<span class="text-brand-600">Pick</span>
          </span>
          <span class="mt-0.5 hidden text-[0.65rem] font-medium tracking-wide text-faint sm:block">
            真实评测 · 套餐对比 · 优惠追踪
          </span>
        </span>
      </a>

      {/* 桌面导航 */}
      <nav class="hidden items-center gap-0.5 lg:flex" aria-label="主导航">
        {
          PRIMARY_NAV.map((item) => (
            <div class="group/nav relative">
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-1 rounded-lg px-3 py-2 text-[0.875rem] font-semibold transition-colors duration-150',
                  isActive(item.href)
                    ? 'bg-brand-50 text-brand-700'
                    : 'text-body hover:bg-[var(--surface-muted)] hover:text-strong',
                ]}
                aria-haspopup={item.children ? 'true' : undefined}
              >
                {item.label}
                {item.children && (
                  <Icon
                    name="chevron-down"
                    size={14}
                    class="text-faint transition-transform duration-200 group-hover/nav:rotate-180"
                  />
                )}
              </a>

              {item.children && (
                <div class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-all duration-200 group-hover/nav:visible group-hover/nav:opacity-100">
                  <div class="w-72 overflow-hidden rounded-xl border border-[var(--hairline)] bg-white p-1.5 shadow-lift">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="block rounded-lg px-3 py-2.5 transition-colors duration-150 hover:bg-brand-50"
                      >
                        <span class="block text-[0.875rem] font-semibold text-strong">{child.label}</span>
                        {child.description && (
                          <span class="mt-0.5 block text-[0.75rem] leading-snug text-soft">{child.description}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </nav>

      {/* 右侧 CTA */}
      <div class="flex items-center gap-2">
        <a
          href="/coupons"
          class="hidden items-center gap-1.5 rounded-lg px-3 py-2 text-[0.875rem] font-semibold text-soft transition-colors hover:bg-[var(--surface-muted)] hover:text-strong xl:flex"
        >
          <Icon name="tag" size={15} />
          优惠码
        </a>
        <AffiliateButton
          category="shared"
          campaign="header"
          label="领取优惠"
          size="sm"
          showCoupon={false}
          class="hidden sm:inline-flex"
        />

        {/* 移动端菜单按钮 */}
        <button
          type="button"
          id="mobile-menu-toggle"
          class="btn btn-ghost !p-2.5 lg:hidden"
          aria-label="打开导航菜单"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" size={22} />
        </button>
      </div>
    </div>
  </div>

  {/* 移动端抽屉 */}
  <div
    id="mobile-menu"
    class="hidden border-t border-[var(--hairline)] bg-white lg:hidden"
  >
    <nav class="container-page py-4" aria-label="移动端导航">
      <ul class="space-y-1">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <details class="group/m">
                <summary
                  class:list={[
                    'flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-[0.9375rem] font-semibold transition-colors',
                    isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-strong hover:bg-[var(--surface-muted)]',
                  ]}
                >
                  <span>{item.label}</span>
                  {item.children ? (
                    <Icon
                      name="chevron-down"
                      size={16}
                      class="text-faint transition-transform duration-200 group-open/m:rotate-180"
                    />
                  ) : (
                    <Icon name="chevron-right" size={16} class="text-faint" />
                  )}
                </summary>
                {item.children && (
                  <ul class="mt-1 space-y-0.5 pb-1 pl-3">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="block rounded-lg px-3 py-2.5 text-[0.875rem] text-soft transition-colors hover:bg-brand-50 hover:text-brand-700"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </details>
            </li>
          ))
        }
      </ul>

      <div class="mt-4 border-t border-[var(--hairline)] pt-4">
        <AffiliateButton category="shared" campaign="mobile-menu" label="领取 Hostinger 优惠" block size="md" />
      </div>
    </nav>
  </div>
</header>

<script>
  // 移动端菜单展开 / 收起
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
  });

  // 滚动时给导航加阴影
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('shadow-soft', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

---
/**
 * CouponCard —— 优惠码卡片，带一键复制
 */
import Icon from './Icon.astro';
import AffiliateButton from './AffiliateButton.astro';
import { affiliateUrl } from '../consts';

interface Props {
  coupon: {
    id: string;
    data: {
      code: string;
      title: string;
      description: string;
      discount: string;
      appliesTo: string[];
      autoApplied: boolean;
      expiresAt?: Date;
      featured: boolean;
      steps: string[];
      verified: boolean;
      lastChecked: Date;
    };
  };
  /** 关联的产品大类，用于生成落地页链接 */
  category?: string;
}

const { coupon, category } = Astro.props;
const c = coupon.data;

const landingCategory = category ?? c.appliesTo[0] ?? 'shared';
const showCode = !c.autoApplied && c.code !== 'AUTO';
---

<article
  class:list={[
    'group relative overflow-hidden rounded-2xl border bg-white p-6 transition-all duration-250',
    c.featured
      ? 'border-brand-300 shadow-[0_2px_4px_rgb(28_28_46/0.04),0_16px_32px_-8px_rgb(103_61_230/0.16)]'
      : 'border-[var(--hairline)] shadow-soft hover:border-brand-200 hover:shadow-card',
  ]}
>
  {c.featured && <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-500 via-brand-400 to-accent-400"></div>}

  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="badge badge-deal">
        <Icon name="percent" size={12} />
        {c.discount}
      </span>
      {c.featured && (
        <span class="badge badge-gold">
          <Icon name="award" size={12} />
          推荐
        </span>
      )}
      {c.autoApplied && (
        <span class="badge badge-accent">
          <Icon name="check" size={12} />
          自动生效
        </span>
      )}
    </div>

    {c.verified && (
      <span class="inline-flex items-center gap-1 text-[0.7rem] font-medium text-accent-600">
        <Icon name="shield-check" size={12} />
        已实测验证
      </span>
    )}
  </div>

  <h3 class="mt-4 text-[1.0625rem] font-bold leading-snug text-strong">{c.title}</h3>
  <p class="mt-2.5 text-[0.875rem] leading-relaxed text-soft">{c.description}</p>

  {/* 适用产品标签 */}
  {
    c.appliesTo.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {c.appliesTo.map((tag) => (
          <span class="rounded-md bg-[var(--surface-muted)] px-2 py-1 text-[0.7rem] font-medium text-soft">
            {tag === 'shared'
              ? '共享主机'
              : tag === 'vps'
                ? 'VPS'
                : tag === 'cloud'
                  ? 'Cloud Hosting'
                  : tag === 'builder'
                    ? 'Website Builder'
                    : tag}
          </span>
        ))}
      </div>
    )
  }

  {/* 优惠码 + 复制 */}
  {
    showCode && (
      <div class="mt-5 flex items-stretch gap-2">
        <div class="flex flex-1 items-center gap-2.5 rounded-lg border-2 border-dashed border-brand-300 bg-brand-50 px-3.5 py-2.5">
          <Icon name="tag" size={15} class="shrink-0 text-brand-600" />
          <code class="truncate font-mono text-[0.9375rem] font-bold tracking-wider text-brand-800">
            {c.code}
          </code>
        </div>
        <button
          type="button"
          class="btn btn-outline !rounded-lg !px-4"
          data-copy-code={c.code}
          aria-label={`复制优惠码 ${c.code}`}
        >
          <Icon name="copy" size={15} />
          <span data-copy-label>复制</span>
        </button>
      </div>
    )
  }

  {/* 使用步骤 */}
  {
    c.steps.length > 0 && (
      <details class="group/steps mt-4">
        <summary class="flex cursor-pointer list-none items-center gap-1.5 text-[0.8125rem] font-semibold text-brand-700">
          <Icon name="list" size={14} />
          使用步骤（{c.steps.length} 步）
          <Icon
            name="chevron-down"
            size={14}
            class="transition-transform duration-200 group-open/steps:rotate-180"
          />
        </summary>
        <ol class="mt-3 space-y-2 pl-1">
          {c.steps.map((step, i) => (
            <li class="flex gap-2.5 text-[0.8125rem] leading-relaxed text-soft">
              <span class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-[0.65rem] font-bold text-brand-700">
                {i + 1}
              </span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </details>
    )
  }

  {/* 转化按钮 */}
  <div class="mt-5 border-t border-[var(--hairline)] pt-5">
    <AffiliateButton
      category={landingCategory}
      campaign={`coupon-${coupon.id}`}
      coupon={showCode ? c.code : undefined}
      label={c.autoApplied ? '前往领取' : '用此优惠码购买'}
      variant={c.featured ? 'primary' : 'outline'}
      block
      showCoupon={false}
    />
    <p class="mt-2.5 flex items-center justify-center gap-3 text-[0.7rem] text-faint">
      <span>
        <Icon name="clock" size={11} class="mr-1 inline align-[-1px]" />
        核验于 {c.lastChecked.toLocaleDateString('zh-CN')}
      </span>
      {
        c.expiresAt && (
          <span class="text-deal-500">
            <Icon name="calendar" size={11} class="mr-1 inline align-[-1px]" />
            {c.expiresAt.toLocaleDateString('zh-CN')} 截止
          </span>
        )
      }
    </p>
  </div>
</article>

<script>
  // 复制优惠码，带视觉反馈
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('[data-copy-code]');
    if (!btn) return;
    const code = btn.dataset.copyCode;
    if (!code) return;

    try {
      await navigator.clipboard.writeText(code);
    } catch {
      // 降级方案：选中文本供用户手动复制
      const range = document.createRange();
      const node = btn.previousElementSibling?.querySelector('code');
      if (node) {
        range.selectNodeContents(node);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }

    const label = btn.querySelector('[data-copy-label]');
    if (!label) return;
    const original = label.textContent;
    label.textContent = '已复制';
    btn.classList.add('!border-accent-400', '!bg-accent-50', '!text-accent-700');
    setTimeout(() => {
      label.textContent = original;
      btn.classList.remove('!border-accent-400', '!bg-accent-50', '!text-accent-700');
    }, 1800);
  });
</script>

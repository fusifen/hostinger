---
/**
 * DealBanner —— 文章内的联盟推广横幅
 * 两种形态：
 *   inline —— 嵌在正文中的横向条（阅读中断时的自然插入点）
 *   sticky —— 右下角常驻悬浮卡（长文的持续转化）
 */
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import AffiliateButton from './AffiliateButton.astro';
import { AFFILIATE } from '../consts';

interface Props {
  variant?: 'inline' | 'sticky';
  plan?: {
    id: string;
    data: {
      name: string;
      tagline: string;
      category: string;
      pricing: { promoPrice: number; regularPrice: number; currency: string; termLabel: string };
      rating: number;
      reviewCount: number;
      freebies: string[];
      affiliate: { campaign?: string; couponCode?: string };
    };
  };
  headline?: string;
  body?: string;
  class?: string;
}

const {
  variant = 'inline',
  plan,
  headline = '当前最优惠的 Hostinger 套餐',
  body,
  class: className = '',
} = Astro.props;

if (!plan) throw new Error('DealBanner 需要一个 plan 属性');
const d = plan!.data;
const coupon = d.affiliate.couponCode ?? AFFILIATE.couponCode;
const savePercent = Math.round((1 - d.pricing.promoPrice / d.pricing.regularPrice) * 100);
---

{
  variant === 'inline' && (
    <aside
      class:list={[
        'not-prose relative my-10 overflow-hidden rounded-2xl border-2 border-brand-200 bg-gradient-to-br from-brand-50 to-white p-6 md:p-7',
        className,
      ]}
      aria-label="Hostinger 套餐推荐"
    >
      <div class="pointer-events-none absolute -right-10 -top-14 h-44 w-44 rounded-full bg-brand-200/40 blur-3xl" />

      <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-brand">
              <Icon name="zap" size={12} />
              本站推荐
            </span>
            <span class="badge badge-deal">省 {savePercent}%</span>
          </div>

          <h3 class="mt-3 text-[1.125rem] font-bold leading-snug text-strong">{headline}</h3>
          <p class="mt-1.5 text-[0.875rem] leading-relaxed text-soft">
            {body ?? `${d.name} · ${d.tagline}`}
          </p>

          <div class="mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-2">
            <div class="flex items-baseline gap-1.5">
              <span class="text-[0.8125rem] font-medium text-soft">{d.pricing.currency}</span>
              <span class="price-now text-2xl">{d.pricing.promoPrice}</span>
              <span class="text-[0.8125rem] text-soft">/ 月</span>
              <span class="price-was ml-1 text-[0.75rem]">
                {d.pricing.currency}{d.pricing.regularPrice}
              </span>
            </div>
            <Stars rating={d.rating} count={d.reviewCount} size={12} />
          </div>

          {
            d.freebies.length > 0 && (
              <ul class="mt-3.5 flex flex-wrap gap-x-4 gap-y-1.5">
                {d.freebies.slice(0, 3).map((f) => (
                  <li class="flex items-center gap-1.5 text-[0.75rem] font-medium text-accent-700">
                    <Icon name="check-circle" size={13} />
                    {f}
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="shrink-0 lg:w-56">
          <AffiliateButton
            category={d.category}
            campaign={d.affiliate.campaign}
            coupon={coupon}
            label="领取优惠"
            size="lg"
            variant="primary"
            block
          />
          <p class="mt-2.5 text-center text-[0.7rem] text-faint">
            30 天无理由退款 · 附赠免费域名
          </p>
        </div>
      </div>
    </aside>
  )
}

{
  variant === 'sticky' && (
    <>
      <div
        id="deal-sticky"
        class:list={[
          'fixed bottom-5 right-5 z-40 hidden w-[320px] translate-y-4 opacity-0 transition-all duration-300 lg:block',
          className,
        ]}
        role="complementary"
        aria-label="限时优惠"
      >
        <div class="overflow-hidden rounded-2xl border border-brand-200 bg-white shadow-lift">
          {/* 关闭按钮 */}
          <button
            type="button"
            id="deal-sticky-close"
            class="absolute right-2.5 top-2.5 z-10 flex h-6 w-6 items-center justify-center rounded-full bg-white/90 text-ink-400 shadow-sm transition-colors hover:bg-white hover:text-ink-700"
            aria-label="关闭优惠卡片"
          >
            <Icon name="x" size={13} />
          </button>

          <div class="bg-gradient-to-br from-brand-600 to-brand-800 px-5 py-4">
            <div class="flex items-center gap-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-white/20 text-white backdrop-blur">
                <Icon name="zap" size={15} />
              </span>
              <div>
                <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-brand-200">限时优惠</p>
                <p class="text-[0.9375rem] font-bold leading-tight text-white">立省 {savePercent}%</p>
              </div>
            </div>
          </div>

          <div class="px-5 py-4">
            <p class="text-[0.8125rem] font-bold text-strong">{d.name}</p>
            <p class="mt-0.5 text-[0.7rem] text-soft">{d.tagline}</p>

            <div class="mt-3 flex items-baseline gap-1.5">
              <span class="text-[0.7rem] text-soft">{d.pricing.currency}</span>
              <span class="price-now text-xl">{d.pricing.promoPrice}</span>
              <span class="text-[0.7rem] text-soft">/ 月</span>
              <span class="price-was ml-1 text-[0.7rem]">
                {d.pricing.currency}{d.pricing.regularPrice}
              </span>
            </div>

            <div class="mt-2.5 rounded-md border border-dashed border-brand-300 bg-brand-50 px-2.5 py-1.5 text-center">
              <span class="text-[0.65rem] text-soft">优惠码</span>
              <code class="ml-1.5 font-mono text-[0.8125rem] font-bold tracking-wider text-brand-800">
                {coupon}
              </code>
            </div>

            <div class="mt-3">
              <AffiliateButton
                category={d.category}
                campaign={`sticky-${d.affiliate.campaign ?? d.category}`}
                coupon={coupon}
                label="立即抢购"
                size="sm"
                variant="accent"
                block
                showCoupon={false}
              />
            </div>
          </div>
        </div>
      </div>

      <script>
        // 滚动到文章中部后再显示，避免开头就打扰阅读
        const card = document.getElementById('deal-sticky');
        const closeBtn = document.getElementById('deal-sticky-close');
        const KEY = 'deal-sticky-dismissed';

        if (card && !sessionStorage.getItem(KEY)) {
          let shown = false;
          const reveal = () => {
            if (shown) return;
            if (window.scrollY > 700) {
              shown = true;
              card.classList.remove('translate-y-4', 'opacity-0');
            }
          };
          reveal();
          window.addEventListener('scroll', reveal, { passive: true });

          closeBtn?.addEventListener('click', () => {
            card.classList.add('translate-y-4', 'opacity-0');
            sessionStorage.setItem(KEY, '1');
            setTimeout(() => card.remove(), 320);
          });
        } else {
          card?.remove();
        }
      </script>
    </>
  )
}

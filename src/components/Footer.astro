---
/**
 * Footer —— 全站页脚
 * 包含站点导航、联盟披露声明（合规必需）、以及最后一道转化入口。
 */
import Icon from './Icon.astro';
import AffiliateButton from './AffiliateButton.astro';
import { SITE, AFFILIATE, ARTICLE_CATEGORIES, PRODUCT_CATEGORIES } from '../consts';

const year = new Date().getFullYear();

const columns = [
  {
    title: '产品与价格',
    links: [
      { label: '全部套餐对比', href: '/pricing' },
      { label: '共享虚拟主机', href: '/pricing#shared' },
      { label: 'VPS 主机 KVM', href: '/pricing#vps' },
      { label: 'Cloud Hosting', href: '/pricing#cloud' },
      { label: 'Website Builder', href: '/pricing#builder' },
      { label: '套餐选择器', href: '/tools/plan-finder' },
    ],
  },
  {
    title: '评测与对比',
    links: [
      { label: 'Hostinger 深度评测', href: '/reviews/hostinger-review-2026' },
      { label: '共享主机实测', href: '/reviews/hostinger-shared-hosting-review' },
      { label: 'VPS 性能测试', href: '/reviews/hostinger-vps-review' },
      { label: '速度与在线率报告', href: '/reviews/hostinger-speed-uptime-test' },
      { label: 'vs SiteGround 对比', href: '/blog/hostinger-vs-siteground' },
      { label: 'VPS vs Cloud', href: '/blog/hostinger-vps-vs-cloud' },
    ],
  },
  {
    title: '建站教程',
    links: [
      { label: '新手建站全流程', href: '/tutorials/build-wordpress-site-on-hostinger' },
      { label: 'hPanel 使用指南', href: '/tutorials/hpanel-complete-guide' },
      { label: 'CyberPanel 部署', href: '/tutorials/cyberpanel-vps-setup' },
      { label: '网站迁移方案', href: '/tutorials/migrate-website-to-hostinger' },
      { label: 'WooCommerce 配置', href: '/tutorials/woocommerce-on-hostinger-setup' },
      { label: '全部教程', href: '/tutorials' },
    ],
  },
  {
    title: '优惠与省钱',
    links: [
      { label: '本月亮优惠', href: '/deals' },
      { label: '优惠码大全', href: '/coupons' },
      { label: '怎么买最便宜', href: '/tutorials/how-to-get-cheapest-hostinger' },
      { label: '续费成本策略', href: '/deals/hostinger-renewal-cost-strategy' },
      { label: '常见问题排查', href: '/faq/hostinger-common-issues' },
      { label: '关于本站', href: '/about' },
    ],
  },
];
---

<footer class="mt-24 border-t border-[var(--hairline)] bg-[var(--surface-muted)]">
  {/* 页脚转化区 */}
  <div class="border-b border-[var(--hairline)] bg-white">
    <div class="container-page py-12">
      <div
        class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 px-7 py-9 md:px-12 md:py-11"
      >
        <div class="bg-grid pointer-events-none absolute inset-0 opacity-[0.18]"></div>
        <div
          class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent-400/20 blur-3xl"
        >
        </div>

        <div class="relative flex flex-col items-start justify-between gap-7 lg:flex-row lg:items-center">
          <div class="max-w-xl">
            <span class="badge bg-white/15 text-white backdrop-blur">
              <Icon name="zap" size={13} />
              限时优惠
            </span>
            <h2 class="mt-3.5 text-h2 font-extrabold text-white">
              还在纠结选哪个套餐？
            </h2>
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-brand-100">
              用套餐选择器回答 4 个问题，30 秒得到匹配你需求的方案，并自动套用当前最优折扣。
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <a href="/tools/plan-finder" class="btn btn-lg bg-white !text-brand-700 hover:bg-brand-50">
                <Icon name="target" size={18} />
                打开套餐选择器
              </a>
              <AffiliateButton
                category="shared"
                campaign="footer-cta"
                label="直接领取优惠"
                size="lg"
                variant="ghost"
                class="!text-white hover:!bg-white/10"
              />
            </div>
          </div>

          <dl class="grid shrink-0 grid-cols-2 gap-x-8 gap-y-4 lg:grid-cols-1 lg:gap-y-3">
            {
              [
                ['75%', '最高折扣'],
                ['30 天', '无理由退款'],
                [`${AFFILIATE.couponCode}`, '专属优惠码'],
              ].map(([value, label]) => (
                <div>
                  <dt class="text-[1.375rem] font-extrabold leading-none text-white tabular-nums">{value}</dt>
                  <dd class="mt-1 text-[0.75rem] font-medium text-brand-200">{label}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </div>

  {/* 导航链接 */}
  <div class="container-page py-14">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      {/* 站点简介 */}
      <div>
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-[0.625rem] bg-gradient-to-br from-brand-500 to-brand-700 text-white"
          >
            <Icon name="rocket" size={19} strokeWidth={1.9} />
          </span>
          <span class="text-[1.0625rem] font-extrabold tracking-tight text-strong">
            Hostinger<span class="text-brand-600">Pick</span>
          </span>
        </div>

        <p class="mt-4 max-w-sm text-[0.8125rem] leading-relaxed text-soft">
          由独立站长运营的 Hostinger 评测与选购指南。所有产品均为自费购买，性能数据来自真实监测，不接受厂商付费改稿。
        </p>

        <ul class="mt-5 space-y-2">
          {
            [
              ['check-circle', '所有评测自费购买，无厂商赞助'],
              ['check-circle', '价格每季度人工核验更新'],
              ['check-circle', '优惠码实测有效后才收录'],
            ].map(([icon, text]) => (
              <li class="flex items-start gap-2 text-[0.8125rem] text-soft">
                <Icon name={icon} size={14} class="mt-0.5 shrink-0 text-accent-500" />
                <span>{text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {/* 四列链接 */}
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h3 class="text-[0.8125rem] font-bold uppercase tracking-wider text-strong">{col.title}</h3>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.8125rem] text-soft transition-colors duration-150 hover:text-brand-700"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    {/* 联盟披露 —— 合规必需，不可删除 */}
    <div class="mt-14 rounded-xl border border-[var(--hairline)] bg-white p-5">
      <h3 class="flex items-center gap-2 text-[0.8125rem] font-bold text-strong">
        <Icon name="info" size={15} class="text-brand-600" />
        联盟推广披露
      </h3>
      <p class="mt-2.5 text-[0.75rem] leading-relaxed text-soft">
        本站通过 Hostinger 联盟计划获取推广佣金。当您通过本站的推广链接购买产品时，Hostinger
        会向我们支付一笔佣金，而<strong class="font-semibold text-strong">您支付的价格不会因此增加</strong>。
        这笔收入用于支付主机测试费用与内容维护成本。我们承诺：所有评测结论基于真实的性能数据与使用体验，
        不接受任何形式的付费改稿；产品的短板与我们发现的问题会如实披露。
        如果您在购买决策上更倾向于参考无商业关联的信息源，我们完全理解。
      </p>
    </div>

    {/* 版权行 */}
    <div
      class="mt-10 flex flex-col items-center justify-between gap-5 border-t border-[var(--hairline)] pt-8 sm:flex-row"
    >
      <p class="text-center text-[0.75rem] text-faint sm:text-left">
        © {year} {SITE.name} · 独立运营的第三方评测站点，与 Hostinger 无隶属关系。
      </p>
      <div class="flex items-center gap-5">
        <a href="/about" class="text-[0.75rem] text-faint transition-colors hover:text-brand-700">关于我们</a>
        <a href="/about#disclosure" class="text-[0.75rem] text-faint transition-colors hover:text-brand-700">
          披露政策
        </a>
        <a href="/contact" class="text-[0.75rem] text-faint transition-colors hover:text-brand-700">联系我们</a>
      </div>
    </div>
  </div>
</footer>

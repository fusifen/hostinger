---
/**
 * 联系我们
 * 明确区分「读者咨询 / 内容纠错 / 商务合作」三条通道，
 * 并在此页正面回应"是否收费评测"这一最高频的商务询问。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import { SITE } from '../consts';

const channels = [
  {
    icon: 'mail',
    title: '读者咨询',
    desc: '套餐选型、教程卡住、数据疑问 —— 任何读得懂的问题都可以问。',
    action: SITE.email,
    href: `mailto:${SITE.email}?subject=${encodeURIComponent('读者咨询')}`,
    responseTime: '工作日 1-2 天内回复',
    accent: 'brand',
  },
  {
    icon: 'alert-triangle',
    title: '内容纠错',
    desc: '价格过时、数据口径有误、步骤跑不通。请附上文章链接与你的实际观察。',
    action: SITE.email,
    href: `mailto:${SITE.email}?subject=${encodeURIComponent('内容纠错反馈')}`,
    responseTime: '确认后 48 小时内修订并标注',
    accent: 'deal',
  },
  {
    icon: 'briefcase',
    title: '商务合作',
    desc: '媒体互推、内容授权、数据引用。请先阅读下方的合作边界说明。',
    action: SITE.email,
    href: `mailto:${SITE.email}?subject=${encodeURIComponent('商务合作咨询')}`,
    responseTime: '3 个工作日内答复',
    accent: 'gold',
  },
];

const boundaries = [
  {
    ok: true,
    title: '可以谈的',
    items: [
      '内容授权转载（需保留原文链接与署名）',
      '数据引用与图表使用（需注明来源 HostingerPick）',
      '媒体互推、联合内容策划',
      '产品信息指正与配置更新同步',
    ],
  },
  {
    ok: false,
    title: '不会做的',
    items: [
      '付费撰写评测或"客观测评"',
      '付费购买榜单排名、推荐位',
      '删除或修改已有的负面结论',
      '在文章中插入未经实测验证的厂商话术',
    ],
  },
];

const faqs = [
  {
    question: '你们收钱做评测吗？',
    answer:
      '不收。本站唯一的收入来源是联盟佣金 —— 读者通过站内的 Hostinger 推广链接购买时，官方支付给我们一笔推荐费。这笔费用不会让你多付钱，也不会改变我们的结论。我们明确拒绝任何形式的付费评测、付费排名与付费删评。',
  },
  {
    question: '我发现价格过时了，怎么反馈最有效？',
    answer:
      '请把「文章链接 + 你看到的实际价格 + 截图（如果有）」一起发到我们的邮箱。带截图与具体套餐名的反馈我们通常当天就能核验并更新。',
  },
  {
    question: '能给具体的套餐选型建议吗？',
    answer:
      '可以，但请附上这四项信息：网站类型（博客 / 企业官网 / 电商）、当前或预估月访问量、是否已有域名、预算区间的心理预期。信息越具体，我们的建议越贴近你的真实需求。如果不想等邮件，也可以先用站内的套餐选择器自助匹配。',
  },
  {
    question: '你们会回复多久？',
    answer:
      '读者咨询与内容纠错在工作日 1-2 天内回复；商务合作 3 个工作日内答复。如果超过一周没有收到回复，请重发一次 —— 有时邮件会被误判为垃圾邮件。',
  },
];
---

<BaseLayout
  title={`联系我们 · ${SITE.name}`}
  description="读者咨询、内容纠错、商务合作 —— 三条通道与明确的合作边界。我们不接受付费评测与付费排名。"
>
  <section class="border-b border-[var(--hairline)] bg-[var(--surface-subtle,#fbfbfe)]">
    <div class="container-page py-14 lg:py-20">
      <Breadcrumbs items={[{ label: '联系我们', href: '/contact' }]} />
      <div class="mt-8 max-w-3xl">
        <p class="eyebrow">CONTACT</p>
        <h1 class="text-h1 mt-4 font-extrabold tracking-tight text-[var(--text-strong)]">
          有事请直接写信
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--text-body)]">
          我们没有客服工单系统，也没有在线聊天窗口 —— 所有来信都由编辑本人查看。
          请根据你的诉求选择下面最合适的标题，能让邮件更快落到对的人手里。
        </p>
      </div>
    </div>
  </section>

  <div class="container-page py-14 lg:py-20">
    <!-- 三条通道 -->
    <div class="grid gap-5 lg:grid-cols-3">
      {channels.map((c) => (
        <div class="flex flex-col rounded-2xl border border-[var(--hairline)] bg-white p-7 transition-shadow hover:shadow-[var(--shadow-card)]">
          <span
            class:list={[
              'flex h-12 w-12 items-center justify-center rounded-xl',
              c.accent === 'brand' && 'bg-brand-50 text-brand-600',
              c.accent === 'deal' && 'bg-deal-50 text-deal-600',
              c.accent === 'gold' && 'bg-gold-50 text-gold-600',
            ]}
          >
            <Icon name={c.icon} size={20} />
          </span>
          <h2 class="mt-5 text-lg font-bold text-[var(--text-strong)]">{c.title}</h2>
          <p class="mt-2.5 flex-1 text-sm leading-relaxed text-[var(--text-body)]">{c.desc}</p>
          <p class="mt-5 flex items-center gap-2 text-xs text-[var(--text-soft)]">
            <Icon name="clock" size={13} />
            {c.responseTime}
          </p>
          <a
            href={c.href}
            class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 underline decoration-brand-200 underline-offset-4 transition-colors hover:decoration-brand-600"
          >
            <Icon name="mail" size={15} />
            <span class="truncate">{c.action}</span>
          </a>
        </div>
      ))}
    </div>

    <!-- 合作边界 -->
    <section class="mt-16">
      <h2 class="text-h2 font-bold tracking-tight text-[var(--text-strong)]">合作边界</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-[var(--text-body)]">
        把话说在前面能省掉双方很多时间。下面是我们能做的和绝不做的 —— 后一条是我们整个内容的立身之本，不会因为报价而松动。
      </p>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {boundaries.map((b) => (
          <div
            class:list={[
              'rounded-2xl border p-7',
              b.ok ? 'border-accent-200 bg-accent-50/50' : 'border-deal-100 bg-deal-50/50',
            ]}
          >
            <h3 class="flex items-center gap-2.5 text-base font-bold text-[var(--text-strong)]">
              <span
                class:list={[
                  'flex h-7 w-7 items-center justify-center rounded-full',
                  b.ok ? 'bg-accent-500 text-white' : 'bg-deal-500 text-white',
                ]}
              >
                <Icon name={b.ok ? 'check' : 'x-circle'} size={14} />
              </span>
              {b.title}
            </h3>
            <ul class="mt-5 space-y-3">
              {b.items.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--text-body)]">
                  <Icon
                    name={b.ok ? 'check' : 'x'}
                    size={15}
                    class:list={['mt-0.5 shrink-0', b.ok ? 'text-accent-600' : 'text-deal-500']}
                  />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 邮件模板提示 -->
    <section class="mt-16">
      <div class="rounded-2xl border border-[var(--hairline)] bg-[var(--surface-subtle,#fbfbfe)] p-7 lg:p-9">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="eyebrow">写信小贴士</p>
            <h2 class="mt-3 text-xl font-bold text-[var(--text-strong)]">带上这四项信息，回复会快很多</h2>
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {[
                '你的网站类型与用途',
                '当前或预估的月访问量',
                '是否已有域名与邮箱需求',
                '预算区间的心理预期',
              ].map((t, i) => (
                <li class="flex items-start gap-3 text-sm text-[var(--text-body)]">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-600 font-mono text-[0.65rem] font-bold text-white">
                    {i + 1}
                  </span>
                  {t}
                </li>
              ))}
            </ul>
          </div>
          <div class="flex flex-col gap-3 lg:w-56">
            <a
              href={`mailto:${SITE.email}?subject=${encodeURIComponent('读者咨询')}&body=${encodeURIComponent('网站类型：\n月访问量：\n已有域名：\n预算区间：\n\n我的问题：\n')}`}
              class="btn btn-primary btn-block"
            >
              <Icon name="mail" size={16} />
              写信给编辑部
            </a>
            <a href="/tools/plan-finder" class="btn btn-outline btn-block">
              <Icon name="target" size={16} />
              先用选择器自助匹配
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-16">
      <h2 class="text-h2 font-bold tracking-tight text-[var(--text-strong)]">常见询问</h2>
      <div class="mt-8">
        <FAQ faqs={faqs} emitSchema />
      </div>
    </section>
  </div>
</BaseLayout>

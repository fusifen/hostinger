---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PlanCard from '../components/PlanCard.astro';
import HostingerPricingMatrix from '../components/HostingerPricingMatrix.astro';
import FAQ from '../components/FAQ.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { PRODUCT_CATEGORIES, AFFILIATE } from '../consts';

const allPlans = await getCollection('hostingerPlans', ({ data }) => data.active);
const sorted = allPlans.sort((a, b) => {
  const catOrder = ['shared', 'vps', 'cloud', 'builder'];
  const diff = catOrder.indexOf(a.data.category) - catOrder.indexOf(b.data.category);
  return diff !== 0 ? diff : a.data.order - b.data.order;
});

const faqs = [
  {
    question: '共享主机、VPS、Cloud Hosting 应该怎么选？',
    answer:
      '按技术能力和流量特征判断。想省事且流量平稳，选共享主机；要 root 权限、跑自建服务，选 VPS；怕流量突发、站点有交易转化，选 Cloud Hosting。三条产品线价格有重叠，但解决的是不同问题。',
  },
  {
    question: '为什么 VPS 的配置比同价位的 Cloud Hosting 高这么多？',
    answer:
      '差额买的是托管服务。Cloud Hosting 包含图形面板、自动扩容、每日备份、CDN 与服务器安全维护；VPS 把这些责任交给你，所以硬件配置可以给得更多。会运维的话 VPS 更实惠，不会的话 Cloud 的实际表现可能更好。',
  },
  {
    question: 'Website Builder 和 WordPress 有什么区别？',
    answer:
      'Builder 是闭源的可视化编辑器，AI 出稿快、上手零门槛，但页面无法导出、SEO 结构控制有限。WordPress 需要一点学习成本，但生态完整、可迁移、适合长期内容运营。想快速上线选 Builder，想做长期资产选 WordPress。',
  },
  {
    question: '付款时长选多久最合适？',
    answer:
      '共享主机选 48 个月能把月均价压到最低（Premium ¥22），但需一次性付清。VPS 通常最长 24 个月。所有套餐都有 30 天退款，所以即使选最长期限，你仍有一个月的验证窗口。',
  },
  {
    question: '续费价会涨多少？有没有办法避免？',
    answer:
      '共享主机续费约 ¥89/月（首购 ¥22），VPS 约 ¥122/月（首购 ¥50）。行业通行的定价方式。应对方式有四种：接受续费、退款重买、降级套餐、更换主机。详见我们的续费成本策略文章。',
  },
  {
    question: '可以在同一账户里同时买多个套餐吗？',
    answer:
      '可以，但每个套餐独立计费。更经济的方式是选高网站额度的套餐：Business 支持 100 个网站、Cloud Professional 支持 300 个。如果你是代理商，一台 VPS 加 CyberPanel 能承载更多站点且成本更低。',
  },
  {
    question: '价格多久更新一次？',
    answer: `本站所有价格每个季度人工核验一次，页面底部标注核验日期。Hostinger 在黑色星期五等大促期间会有额外折扣，届时我们会同步更新。当前优惠码 ${AFFILIATE.couponCode} 在结账页实测生效。`,
  },
];

const totalPlans = allPlans.length;
const cheapest = Math.min(...allPlans.map((p) => p.data.pricing.promoPrice));
---

<BaseLayout
  title="Hostinger 全部套餐价格与配置对比（2026 年最新）"
  description={`Hostinger ${totalPlans} 个在售套餐的完整价格与配置对比：共享主机、KVM VPS、Cloud Hosting 与 Website Builder。含促销价、续费价、核心配置与专家点评，低至 ¥${cheapest}/月。`}
  keywords={['Hostinger价格', 'Hostinger套餐', 'Hostinger套餐对比', 'Hostinger VPS价格', 'Hostinger多少钱']}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Hostinger 全部在售套餐',
    numberOfItems: totalPlans,
    itemListElement: sorted.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.data.fullName,
      description: p.data.tagline,
    })),
  }}
>
  {/* ── 页头 ── */}
  <section class="border-b border-[var(--hairline)] bg-[var(--surface-muted)]">
    <div class="container-page py-4">
      <Breadcrumbs items={[{ label: '套餐与价格' }]} />
    </div>
  </section>

  <section class="relative overflow-hidden border-b border-[var(--hairline)]">
    <div class="bg-radial-brand pointer-events-none absolute inset-0"></div>
    <div class="container-page relative py-12 lg:py-16">
      <div class="max-w-3xl">
        <span class="eyebrow">
          <Icon name="table" size={14} />
          全产品线对比
        </span>
        <h1 class="mt-3.5 text-h1 font-extrabold">
          Hostinger 全部 {totalPlans} 个套餐的价格与配置对比
        </h1>
        <p class="mt-5 text-[1.0625rem] leading-relaxed text-soft">
          四条产品线、{totalPlans} 个在售套餐，放在同一张表里逐项对比。
          促销价、续费价、核心配置与权益清单全部公开，每个套餐的短板也如实标注。
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <AffiliateButton
            category="shared"
            campaign="pricing-hero"
            label="领取 Hostinger 优惠"
            size="lg"
            variant="primary"
          />
          <a href="/tools/plan-finder" class="btn btn-lg btn-outline">
            <Icon name="target" size={18} />
            不确定？用选择器
          </a>
        </div>

        <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.75rem] text-soft">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="shield-check" size={14} class="text-accent-500" />
            价格人工核验于 {new Date().toLocaleDateString('zh-CN')}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="percent" size={14} class="text-brand-500" />
            叠加优惠码 {AFFILIATE.couponCode} 再省 10%
          </span>
        </p>
      </div>

      {/* 快速跳转 */}
      <nav class="mt-10 flex flex-wrap gap-2.5" aria-label="产品线快速跳转">
        {
          PRODUCT_CATEGORIES.map((cat) => {
            const count = allPlans.filter((p) => p.data.category === cat.slug).length;
            return (
              <a
                href={`#${cat.slug}`}
                class="inline-flex items-center gap-2 rounded-full border border-[var(--hairline)] bg-white px-4 py-2.5 text-[0.8125rem] font-semibold text-body shadow-soft transition-all hover:border-brand-300 hover:text-brand-700"
              >
                <Icon name={cat.icon} size={15} />
                {cat.label}
                <span class="rounded-md bg-[var(--surface-muted)] px-1.5 py-0.5 text-[0.65rem] text-soft">
                  {count}
                </span>
              </a>
            );
          })
        }
      </nav>
    </div>
  </section>

  {/* ── 卡片网格（按产品线分组） ── */}
  <section class="container-page py-14 lg:py-18">
    <HostingerPricingMatrix plans={sorted} mode="grid" groupByCategory />
  </section>

  {/* ── 逐项对比表 ── */}
  <section class="border-y border-[var(--hairline)] bg-[var(--surface-muted)] py-14 lg:py-18">
    <div class="container-page">
      <div class="max-w-2xl">
        <span class="eyebrow">
          <Icon name="list" size={14} />
          逐项对比
        </span>
        <h2 class="mt-3 text-h2 font-bold">每个规格摆在一张表里</h2>
        <p class="mt-3.5 text-[0.9375rem] leading-relaxed text-soft">
          卡片看的是整体印象，表格看的是具体差异。下面是同系列内各套餐的逐项对照。
        </p>
      </div>

      <div class="mt-10 space-y-12">
        {
          PRODUCT_CATEGORIES.map((cat) => {
            const items = sorted.filter((p) => p.data.category === cat.slug);
            if (items.length === 0) return null;
            return (
              <div id={`table-${cat.slug}`}>
                <div class="mb-5 flex items-center gap-2.5">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-100 text-brand-700">
                    <Icon name={cat.icon} size={16} />
                  </span>
                  <h3 class="text-h3 font-bold">{cat.label}</h3>
                </div>
                <HostingerPricingMatrix plans={items} mode="table" />
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ── 选型决策指南 ── */}
  <section class="container-page py-14 lg:py-18">
    <div class="max-w-2xl">
      <span class="eyebrow">
        <Icon name="target" size={14} />
        选型指南
      </span>
      <h2 class="mt-3 text-h2 font-bold">按你的情况直接对号入座</h2>
    </div>

    <div class="mt-9 overflow-hidden rounded-2xl border border-[var(--hairline)] bg-white shadow-soft">
      <div class="overflow-x-auto">
        <table class="matrix-table min-w-[680px]">
          <caption class="sr-only">按使用场景推荐套餐</caption>
          <thead>
            <tr>
              <th scope="col">你的情况</th>
              <th scope="col">推荐套餐</th>
              <th scope="col">月均</th>
              <th scope="col">核心理由</th>
            </tr>
          </thead>
          <tbody>
            {
              [
                ['第一次建站，预算紧张', 'Premium', '¥22', '25 个网站 + 不限流量 + 赠域名，性价比断层'],
                ['有交易转化、怕丢订单数据', 'Business', '¥30', '每日备份 + 内置 CDN + 2 核 CPU'],
                ['跑广告，怕流量突发', 'Cloud Startup', '¥65', '4 倍资源隔离 + 自动扩容'],
                ['要 root、跑多个站点', 'VPS KVM 2', '¥50', '2 核 8GB 是面板类应用的舒适起点'],
                ['跑 Docker 与多服务', 'VPS KVM 4', '¥78', '4 核 16GB 才有多服务共存余量'],
                ['完全不懂代码', 'Website Builder', '¥25', 'AI 出稿，实测 26 分钟上线'],
                ['小型电商、SKU 在 50 内', 'Builder Business', '¥40', '内置电商模块，不用配 WooCommerce'],
                ['代理商批量交付', 'VPS KVM 4 + CyberPanel', '¥78', '每站成本可压到 ¥3 以下'],
              ].map((row) => (
                <tr>
                  <td class="font-medium text-strong">{row[0]}</td>
                  <td>
                    <span class="badge badge-brand">{row[1]}</span>
                  </td>
                  <td class="font-semibold text-strong tabular-nums">{row[2]}</td>
                  <td class="text-soft">{row[3]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="border-t border-[var(--hairline)] bg-[var(--surface-muted)] py-14 lg:py-18">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <FAQ
          faqs={faqs}
          title="关于 Hostinger 套餐与价格的常见问题"
          subtitle="选型、付款时长、续费成本、产品线差异，这里都有答案。"
          emitSchema
        />

        <div
          class="mt-10 flex flex-col items-center gap-4 rounded-2xl border-2 border-brand-200 bg-white p-8 text-center"
        >
          <h2 class="text-h3 font-bold">已经确定要买了？</h2>
          <p class="max-w-md text-[0.9375rem] leading-relaxed text-soft">
            记得两个动作：付款时长选到最长，结账页输入优惠码 {AFFILIATE.couponCode}。
          </p>
          <AffiliateButton
            category="shared"
            campaign="pricing-footer"
            label="领取 Hostinger 优惠"
            size="lg"
            variant="primary"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

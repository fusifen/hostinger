---
/**
 * 关于我们
 * E-E-A-T 的核心载体：说明「我们是谁、怎么测的、靠什么赚钱」。
 * #disclosure 锚点被全站页脚与文章公告框引用，请勿删除。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import { SITE, TRUST_STATS, AFFILIATE } from '../consts';
import { getCollection } from 'astro:content';

const authors = await getCollection('authors');
const articles = await getCollection('articles', ({ data }) => !data.draft);

/** 每位作者的署名文章数 */
function countBy(authorName: string) {
  return articles.filter((a) => a.data.author === authorName).length;
}

const principles = [
  {
    icon: 'activity',
    title: '所有性能结论来自自购实测',
    body: '我们不用官方宣传材料里的数字。每一台测试机都是编辑部自费购买的真实套餐，测试脚本、采样频率与原始数据口径全部公开。',
  },
  {
    icon: 'alert-triangle',
    title: '续费价永远与首购价并列展示',
    body: '主机行业最大的信息不对称就是「首购低价 + 续费暴涨」。我们在每一个价格卡片上都并排标注促销价与续费价，绝不隐藏涨幅。',
  },
  {
    icon: 'refresh',
    title: '价格每月核验并标注日期',
    body: '所有套餐数据都带有 lastChecked 时间戳。价格由官方调整而失效时，我们会尽快同步；发现过时数据欢迎随时邮件告知。',
  },
  {
    icon: 'lock',
    title: '不接任何付费评测与软文',
    body: '我们只赚取联盟佣金。品牌方无法付费购买排名、购买好评，也无法要求我们删除负面结论 —— 因为我们的结论来自实测数据。',
  },
];

const methodology = [
  { step: '01', title: '采购', body: '用普通用户身份下单，走与读者完全相同的购买流程，不使用媒体测试账号。' },
  { step: '02', title: '部署', body: '安装标准化测试站点（WordPress + WooCommerce + 1200 篇演示内容 + 42 张图片），保证跨主机可比。' },
  { step: '03', title: '监测', body: '12 个全球节点、每 5 分钟一次采样，持续 90 天，记录 TTFB、状态码、DNS 与 TLS 握手耗时。' },
  { step: '04', title: '压测', body: '用 k6 与 sysbench 施加阶梯负载，记录每档并发下的 P95 响应时间与错误率拐点。' },
  { step: '05', title: '归因', body: '把异常波动与官方状态页、工单记录交叉比对，剔除误报，再输出结论。' },
  { step: '06', title: '复核', body: '结论发布 90 天后重新跑一轮抽样复测，若数据漂移则更新文章并标注修订日期。' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `关于 ${SITE.name}`,
  url: `${SITE.url}/about`,
  description: SITE.description,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
  },
};
---

<BaseLayout
  title={`关于我们 · 评测方法与联盟披露 · ${SITE.name}`}
  description="HostingerPick 由一支 4 人编辑团队运营。我们自费购买每一台测试主机，公开测试方法与原始数据，靠联盟佣金而非软文维持运营。"
  schema={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-[var(--hairline)] bg-[var(--surface-subtle,#fbfbfe)]">
    <div class="container-page py-14 lg:py-20">
      <Breadcrumbs items={[{ label: '关于我们', href: '/about' }]} />
      <div class="mt-8 max-w-3xl">
        <p class="eyebrow">ABOUT</p>
        <h1 class="text-h1 mt-4 font-extrabold tracking-tight text-[var(--text-strong)]">
          我们只做一件事：<br class="hidden sm:block" />
          把 Hostinger 的真实表现讲清楚
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--text-body)]">
          {SITE.name} 不是 Hostinger 的官方站点，也不受其内容干预。我们是一支 4 人编辑团队，
          自费购买测试主机、自建监测脚本、公开全部方法论。
          我们的收入来自联盟佣金 —— 也就是你通过我们的链接购买时，Hostinger 支付给我们的一小笔推荐费。
          <span class="font-semibold text-[var(--text-strong)]">这笔钱不会让你多付一分。</span>
        </p>
      </div>

      <!-- 信任数据 -->
      <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-[var(--hairline)] pt-10 lg:grid-cols-4">
        {TRUST_STATS.map((s) => (
          <div>
            <dt class="text-3xl font-extrabold tracking-tight text-brand-600 lg:text-4xl">{s.value}</dt>
            <dd class="mt-2">
              <span class="block text-sm font-semibold text-[var(--text-strong)]">{s.label}</span>
              <span class="mt-0.5 block text-xs text-[var(--text-soft)]">{s.sub}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="container-page py-16 lg:py-24">
    <div class="grid gap-16 lg:grid-cols-[1fr_320px] lg:gap-20">
      <div class="min-w-0">
        <!-- 编辑原则 -->
        <section>
          <h2 class="text-h2 font-bold tracking-tight text-[var(--text-strong)]">四条编辑原则</h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-[var(--text-body)]">
            这些原则写进了我们的工作流，不是营销话术。如果你发现我们违反了其中任何一条，请直接写信告诉我们。
          </p>

          <div class="mt-10 grid gap-5 sm:grid-cols-2">
            {principles.map((p) => (
              <div class="rounded-2xl border border-[var(--hairline)] bg-white p-6">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                  <Icon name={p.icon} size={19} />
                </span>
                <h3 class="mt-5 text-base font-bold leading-snug text-[var(--text-strong)]">{p.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-body)]">{p.body}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- 测试方法论 -->
        <section class="mt-20">
          <h2 class="text-h2 font-bold tracking-tight text-[var(--text-strong)]">测试方法论</h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-[var(--text-body)]">
            从下单到结论，我们的评测要经过 6 个固定环节。这套流程保证了「iPhone 拍月亮式」的滤镜不会出现在我们的数据里。
          </p>

          <ol class="mt-10 space-y-0">
            {methodology.map((m, i) => (
              <li class="relative flex gap-6 pb-8 last:pb-0">
                {i < methodology.length - 1 && (
                  <span class="absolute left-[19px] top-11 h-full w-px bg-[var(--hairline)]" aria-hidden="true" />
                )}
                <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-brand-200 bg-white font-mono text-xs font-bold text-brand-600">
                  {m.step}
                </span>
                <div class="pt-1.5">
                  <h3 class="text-base font-bold text-[var(--text-strong)]">{m.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-body)]">{m.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- 联盟披露 -->
        <section id="disclosure" class="mt-20 scroll-mt-28">
          <div class="rounded-2xl border-2 border-gold-200 bg-gold-50/60 p-7 lg:p-9">
            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-gold-600 shadow-sm">
                <Icon name="info" size={19} />
              </span>
              <div class="min-w-0">
                <h2 class="text-xl font-bold tracking-tight text-[var(--text-strong)]">
                  联盟推广披露（Affiliate Disclosure）
                </h2>
                <p class="mt-4 text-sm leading-relaxed text-[var(--text-body)]">
                  本站参与 Hostinger 联盟推广计划。当读者通过站内带有
                  <code class="rounded bg-white/70 px-1.5 py-0.5 font-mono text-xs">rel="sponsored"</code>
                  标记的链接完成购买时，我们可能获得一笔推荐佣金。这是本站唯一的收入来源。
                </p>

                <div class="mt-6 grid gap-3 sm:grid-cols-2">
                  <div class="rounded-xl border border-gold-200/70 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-wider text-accent-600">佣金不会影响你</p>
                    <p class="mt-2 text-sm leading-relaxed text-[var(--text-body)]">
                      联盟链接使用的是 Hostinger 官方公开促销价，与你直接访问官网购买的价格完全一致，不会加价。
                    </p>
                  </div>
                  <div class="rounded-xl border border-gold-200/70 bg-white p-4">
                    <p class="text-xs font-bold uppercase tracking-wider text-accent-600">佣金不会影响结论</p>
                    <p class="mt-2 text-sm leading-relaxed text-[var(--text-body)]">
                      我们不接受付费评测、付费排名或付费删评。所有负面结论（如续费涨幅、不支持的功能）都完整保留在文章中。
                    </p>
                  </div>
                </div>

                <dl class="mt-6 divide-y divide-gold-200/70 border-t border-gold-200/70 text-sm">
                  <div class="flex flex-wrap items-baseline justify-between gap-2 py-3">
                    <dt class="text-[var(--text-soft)]">联盟追踪码</dt>
                    <dd class="font-mono text-xs font-semibold text-[var(--text-strong)]">{AFFILIATE.referralCode}</dd>
                  </div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2 py-3">
                    <dt class="text-[var(--text-soft)]">品牌优惠码</dt>
                    <dd class="font-mono text-xs font-semibold text-[var(--text-strong)]">{AFFILIATE.couponCode} · {AFFILIATE.couponLabel}</dd>
                  </div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2 py-3">
                    <dt class="text-[var(--text-soft)]">价格核验频率</dt>
                    <dd class="text-xs font-semibold text-[var(--text-strong)]">每月人工核验 + 变更即时同步</dd>
                  </div>
                </dl>

                <div class="mt-7">
                  <AffiliateButton
                    category="shared"
                    campaign="about-disclosure"
                    label="查看当前 Hostinger 官方价格"
                    size="sm"
                    variant="outline"
                  />
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 纠错 -->
        <section class="mt-12">
          <div class="rounded-2xl border border-[var(--hairline)] bg-white p-7">
            <h2 class="text-lg font-bold text-[var(--text-strong)]">发现错误？请直接告诉我们</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text-body)]">
              价格过时、数据口径有误、结论逻辑不通 —— 我们都会认真处理。被采纳的有效纠错，我们会在对应文章末尾注明修订记录。
            </p>
            <a
              href={`mailto:${SITE.email}?subject=${encodeURIComponent('内容纠错反馈')}`}
              class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 underline decoration-brand-200 underline-offset-4 hover:decoration-brand-600"
            >
              <Icon name="mail" size={15} />
              {SITE.email}
            </a>
          </div>
        </section>
      </div>

      <!-- 侧栏：团队 -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-[var(--hairline)] bg-white p-6">
          <p class="eyebrow">编辑团队</p>
          <ul class="mt-5 space-y-5">
            {authors.map((a) => (
              <li class="flex gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                  {a.data.initials ?? a.data.name.slice(0, 1)}
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-[var(--text-strong)]">{a.data.name}</p>
                  <p class="mt-0.5 text-xs font-medium text-brand-600">{a.data.role}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-[var(--text-soft)]">{a.data.bio}</p>
                  {a.data.expertise && a.data.expertise.length > 0 && (
                    <p class="mt-2 text-[0.7rem] text-[var(--text-faint)]">
                      署名文章 {countBy(a.data.name)} 篇 · {a.data.expertise.slice(0, 2).join(' / ')}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 rounded-2xl border border-[var(--hairline)] bg-[var(--surface-subtle,#fbfbfe)] p-6">
          <p class="eyebrow">联系方式</p>
          <ul class="mt-5 space-y-3.5 text-sm">
            <li class="flex items-start gap-3">
              <Icon name="mail" size={15} class="mt-0.5 shrink-0 text-brand-600" />
              <div>
                <p class="font-semibold text-[var(--text-strong)]">读者咨询</p>
                <a href={`mailto:${SITE.email}`} class="text-xs text-[var(--text-soft)] hover:text-brand-600">{SITE.email}</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="briefcase" size={15} class="mt-0.5 shrink-0 text-brand-600" />
              <div>
                <p class="font-semibold text-[var(--text-strong)]">商务合作</p>
                <a href="/contact" class="text-xs text-[var(--text-soft)] hover:text-brand-600">请先阅读合作说明</a>
              </div>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
